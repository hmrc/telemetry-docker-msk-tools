#!/usr/bin/env bash
#MISE description="Prepare dependencies and run unit tests in a Docker environment"
#MISE depends=["package"]
#MISE raw=true

VERSION=$(cat .version)
export IMAGE_VERSION=${VERSION:-0}

aws ecr get-login-password --region "eu-west-2" | docker login --username AWS --password-stdin "${IMAGE_REPO}"

docker run --rm \
           --tty \
           --platform 'linux/amd64' \
           "${IMAGE_REPO}/${IMAGE_NAME}:${IMAGE_VERSION}" /bin/topicctl --version
